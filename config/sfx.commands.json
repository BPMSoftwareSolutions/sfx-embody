{
  "mappingType": "sfx-command-mapping.v1",
  "surfaces": {
    "database-invocation": {
      "delivery": "database-memory",
      "operations": ["invoke"]
    }
  },
  "identities": {
    "capability": { "pattern": "^[a-z][a-z0-9-]*$", "message": "Supply a capability identity." }
  },
  "commands": {
    "capability": {
      "invoke": {
        "min": 1, "max": 1, "identity": "capability", "input": true, "namespace": true,
        "wraps": { "surface": "database-invocation", "operation": "invoke" },
        "description": "Execute the database capability's declared root through the candidate memory provider."
      }
    }
  }
}

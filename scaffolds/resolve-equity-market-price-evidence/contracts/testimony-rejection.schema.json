{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/native-equity-market-price-testimony-rejection.v1.schema.json",
  "title": "Native equity market price testimony rejection",
  "description": "The native testimony is rejected without widening the mapping or emitting canonical price evidence.",
  "type": "object",
  "required": ["contractId", "disposition", "reasonCode"],
  "properties": {
    "contractId": {
      "const": "native-equity-market-price-testimony-rejection.v1"
    },
    "disposition": {
      "const": "NATIVE_MARKET_PRICE_TESTIMONY_REJECTED"
    },
    "reasonCode": {
      "const": "REQUIRED_NATIVE_FIELDS_ABSENT"
    },
    "absentFieldCount": {
      "type": "integer",
      "minimum": 0
    },
    "providerTestimony": {
      "type": "object"
    }
  }
}

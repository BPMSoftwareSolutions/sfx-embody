{
  "configurationType": "sfx-project.v1",
  "commands": "config/sfx.commands.json",
  "deliveries": {
    "database-memory": {
      "type": "process",
      "command": "node",
      "cwd": ".",
      "args": [
        "--experimental-permission",
        "--allow-addons",
        "--allow-child-process",
        "--allow-fs-read=./providers",
        "--allow-fs-read=../scenario-driven-architecture",
        "--allow-fs-read=C:\\Users\\*\\AppData\\Local\\sfx",
        "../scenario-driven-architecture/languages/typescript/src/kernel/bootstrap/entry.mjs",
        "--stdin-envelope"
      ]
    },
    "database-projection": {
      "type": "process",
      "command": "node",
      "cwd": ".",
      "args": [
        "../scenario-driven-architecture/languages/typescript/src/kernel/bootstrap/entry.mjs",
        "--stdin-envelope"
      ]
    }
  }
}

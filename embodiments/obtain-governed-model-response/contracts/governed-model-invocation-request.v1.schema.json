{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/governed-model-invocation-request.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/governed-model-invocation-request.v1"
    }
  ],
  "$defs": {
    "governed-model-invocation-request.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrierType",
        "requestId",
        "requestHash",
        "modelRequest",
        "requestLineage"
      ],
      "properties": {
        "carrierType": {
          "const": "governed-model-invocation-request.v1"
        },
        "requestId": {
          "$ref": "#/$defs/identity"
        },
        "requestHash": {
          "$ref": "#/$defs/sha256"
        },
        "modelRequest": {
          "$ref": "#/$defs/modelRequest"
        },
        "providerConveyor": {
          "type": "object"
        },
        "requestLineage": {
          "$ref": "#/$defs/lineage"
        }
      }
    },
    "modelRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "requestId",
        "providerAuthorityId",
        "modelAlias",
        "interaction",
        "responsePolicy",
        "executionPolicy",
        "evidencePolicy"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "$ref": "#/$defs/identity"
        },
        "providerAuthorityId": {
          "type": "string",
          "minLength": 1
        },
        "modelAlias": {
          "type": "string",
          "minLength": 1
        },
        "interaction": {
          "type": "object"
        },
        "responsePolicy": {
          "type": "object"
        },
        "executionPolicy": {
          "type": "object"
        },
        "evidencePolicy": {
          "type": "object"
        }
      }
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/governed-model-response-evidence.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/governed-model-response-evidence.v1"
    },
    {
      "$ref": "#/$defs/governed-model-response-evidence.alias-rejection.v1"
    }
  ],
  "$defs": {
    "governed-model-response-evidence.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrierType",
        "requestId",
        "disposition",
        "resolvedProvider",
        "resolvedModel",
        "attemptCount",
        "timing",
        "requestHash",
        "responseHash",
        "normalizedResponse",
        "acceptanceClaimed",
        "effectLineage"
      ],
      "properties": {
        "carrierType": {
          "const": "governed-model-response-evidence.v1"
        },
        "requestId": {
          "$ref": "#/$defs/identity"
        },
        "disposition": {
          "enum": [
            "MODEL_RESPONSE_OBTAINED",
            "PROVIDER_REQUEST_REJECTED",
            "PROVIDER_TIMED_OUT",
            "PROVIDER_UNAVAILABLE",
            "PROVIDER_AUTHENTICATION_FAILED",
            "EXECUTION_CANCELLED",
            "INTERNAL_EXECUTION_FAILED",
            "RESPONSE_FORMAT_NOT_SATISFIED",
            "MODEL_REQUEST_REJECTED"
          ]
        },
        "resolvedProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolvedProviderAuthorityId": {
          "type": "string",
          "minLength": 1
        },
        "resolvedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "startedAt",
            "completedAt",
            "durationMilliseconds"
          ],
          "properties": {
            "startedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "completedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            "durationMilliseconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "requestHash": {
          "$ref": "#/$defs/sha256"
        },
        "responseHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "normalizedResponse": {
          "type": [
            "object",
            "null"
          ]
        },
        "acceptanceClaimed": {
          "const": false
        },
        "providerSwitchCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "resolvedProtocolProjection": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "requestType",
            "providerKind",
            "providerAuthorityId",
            "resolvedModel",
            "responseFormat"
          ],
          "properties": {
            "requestType": {
              "type": "string",
              "minLength": 1
            },
            "providerKind": {
              "type": "string",
              "minLength": 1
            },
            "providerAuthorityId": {
              "type": "string",
              "minLength": 1
            },
            "resolvedModel": {
              "type": [
                "string",
                "null"
              ]
            },
            "responseFormat": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "effectLineage": {
          "$ref": "#/$defs/lineage"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "identity": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "governed-model-response-evidence.alias-rejection.v1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "carrierType",
        "requestId",
        "disposition",
        "resolvedProvider",
        "resolvedModel",
        "attemptCount",
        "requestHash",
        "responseHash",
        "normalizedResponse",
        "acceptanceClaimed",
        "effectLineage",
        "payload"
      ],
      "properties": {
        "carrierType": {
          "const": "governed-model-response-evidence.v1"
        },
        "requestId": {
          "$ref": "#/$defs/identity"
        },
        "disposition": {
          "const": "MODEL_REQUEST_REJECTED"
        },
        "resolvedProvider": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolvedModel": {
          "type": [
            "string",
            "null"
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "requestHash": {
          "$ref": "#/$defs/sha256"
        },
        "responseHash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "normalizedResponse": {
          "type": [
            "object",
            "null"
          ]
        },
        "acceptanceClaimed": {
          "const": false
        },
        "effectLineage": {
          "$ref": "#/$defs/lineage"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/model-provider-protocol-response-policy.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "carrierType",
    "requestId",
    "requestHash",
    "modelRequest",
    "requestLineage",
    "protocolResponsePolicy"
  ],
  "properties": {
    "carrierType": {
      "const": "governed-model-invocation-request.v1"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "modelRequest": {
      "type": "object"
    },
    "providerConveyor": {
      "type": "object"
    },
    "requestLineage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "protocolResponsePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "responseSchema",
        "schemaSourceConnector"
      ],
      "properties": {
        "format": {
          "enum": [
            "text",
            "json"
          ]
        },
        "responseSchema": {
          "type": [
            "object",
            "null"
          ]
        },
        "schemaSourceConnector": {
          "const": "modelRequest.responsePolicy.schema"
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

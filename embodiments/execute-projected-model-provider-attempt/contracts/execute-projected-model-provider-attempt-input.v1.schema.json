{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/execute-projected-model-provider-attempt-input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "payload"
  ],
  "properties": {
    "contractId": {
      "const": "execute-projected-model-provider-attempt-input.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "invocationIdentity",
        "providerAuthorityId",
        "providerKind",
        "resolvedModel",
        "adapterIdentity",
        "protocolProjectionIdentity",
        "protocolProjectionRequest",
        "credentialReference",
        "endpointAuthorityDigest",
        "endpointUrl",
        "responseFormat",
        "timeoutMilliseconds",
        "cancellationScopeReference",
        "maxResponseBytes",
        "allowedResponseHeaders",
        "requestLineage"
      ],
      "properties": {
        "requestId": {
          "type": "string"
        },
        "invocationIdentity": {
          "type": "string"
        },
        "providerAuthorityId": {
          "type": "string"
        },
        "providerKind": {
          "type": "string"
        },
        "resolvedModel": {
          "type": "string"
        },
        "adapterIdentity": {
          "type": "string"
        },
        "protocolProjectionIdentity": {
          "type": "string"
        },
        "protocolProjectionRequest": {
          "type": "object"
        },
        "credentialReference": {
          "type": "string"
        },
        "endpointAuthorityDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "endpointUrl": {
          "type": "string"
        },
        "responseFormat": {
          "enum": [
            "text",
            "json"
          ]
        },
        "timeoutMilliseconds": {
          "type": "integer",
          "minimum": 1
        },
        "cancellationScopeReference": {
          "type": "string"
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1
        },
        "allowedResponseHeaders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requestLineage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}



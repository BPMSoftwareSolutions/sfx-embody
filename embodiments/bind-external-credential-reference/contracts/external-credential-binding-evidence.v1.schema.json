{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/external-credential-binding-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "disposition",
    "opaqueBindingId",
    "referenceName",
    "invocationIdentity",
    "requestingCapabilityId",
    "endpointAuthorityDigest",
    "credentialInjectionRuleId",
    "nonDisclosureVerified",
    "detail",
    "effectLineage"
  ],
  "properties": {
    "contractId": { "const": "external-credential-binding-evidence.v1" },
    "disposition": {
      "enum": [
        "BOUND",
        "CREDENTIAL_NOT_AVAILABLE",
        "UNAUTHORIZED_REFERENCE",
        "IDENTITY_MISMATCH",
        "STALE_BINDING_REJECTED",
        "EMBEDDED_CREDENTIAL_REJECTED"
      ]
    },
    "opaqueBindingId": { "type": "string" },
    "referenceName": { "type": "string" },
    "invocationIdentity": { "type": "string" },
    "requestingCapabilityId": { "type": "string" },
    "endpointAuthorityDigest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "credentialInjectionRuleId": { "type": "string" },
    "nonDisclosureVerified": { "const": true },
    "detail": { "type": "string" },
    "effectLineage": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

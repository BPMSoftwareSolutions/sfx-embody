{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/governed-http-request-body-projection-evidence.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "payload"
  ],
  "properties": {
    "contractId": {
      "const": "governed-http-request-body-projection-evidence.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestBodyText",
        "textEncodingAuthority",
        "mediaType",
        "requestTextDigest",
        "providerAdapterIdentity",
        "invocationIdentity",
        "projectionAuthorityIdentity",
        "networkExchangeCount",
        "retryCount",
        "repairCount",
        "providerSubstitutionCount",
        "remoteTestimonyClaimed",
        "acceptanceClaimed"
      ],
      "properties": {
        "requestBodyText": {
          "type": "string"
        },
        "textEncodingAuthority": {
          "const": "utf-8"
        },
        "mediaType": {
          "const": "application/json"
        },
        "requestTextDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "providerAdapterIdentity": {
          "type": "string",
          "minLength": 1
        },
        "invocationIdentity": {
          "type": "string",
          "minLength": 1
        },
        "projectionAuthorityIdentity": {
          "type": "string",
          "minLength": 1
        },
        "networkExchangeCount": {
          "const": 0
        },
        "retryCount": {
          "const": 0
        },
        "repairCount": {
          "const": 0
        },
        "providerSubstitutionCount": {
          "const": 0
        },
        "remoteTestimonyClaimed": {
          "const": false
        },
        "acceptanceClaimed": {
          "const": false
        }
      }
    }
  }
}


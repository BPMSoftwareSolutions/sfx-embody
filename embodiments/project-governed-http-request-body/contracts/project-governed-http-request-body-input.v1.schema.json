{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/project-governed-http-request-body-input.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "payload"
  ],
  "properties": {
    "contractId": {
      "const": "project-governed-http-request-body-input.v1"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wireRequestDocument",
        "providerAdapterIdentity",
        "invocationIdentity",
        "projectionAuthorityIdentity"
      ],
      "properties": {
        "wireRequestDocument": {
          "type": "object"
        },
        "providerAdapterIdentity": {
          "type": "string",
          "minLength": 1
        },
        "invocationIdentity": {
          "type": "string",
          "minLength": 1
        },
        "projectionAuthorityIdentity": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}


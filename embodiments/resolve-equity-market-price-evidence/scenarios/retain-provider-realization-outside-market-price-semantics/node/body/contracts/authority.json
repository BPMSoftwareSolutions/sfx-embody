{
  "contracts": {
    "equity-market-price-evidence-request.v1": {
      "schemaRef": "capabilities/resolve-equity-market-price-evidence/contracts/equity-market-price-evidence-request.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/equity-market-price-evidence-request.v1.schema.json",
      "schemaDigest": "e1b742bedc62bb2c1bdb2e362996ae7432c3d189c34b91fc39e2ecbda45e0679",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/equity-market-price-evidence-request.v1.schema.json",
        "title": "Equity market price evidence request",
        "description": "One canonical request for provider-neutral equity market price evidence. The native provider testimony, provider binding and credential realization remain outside the capability's semantic identity.",
        "type": "object",
        "required": [
          "contractId",
          "payload"
        ],
        "additionalProperties": false,
        "properties": {
          "contractId": {
            "const": "equity-market-price-evidence-request.v1"
          },
          "payload": {
            "type": "object",
            "required": [
              "nativeTestimony",
              "region",
              "providerBinding"
            ],
            "additionalProperties": false,
            "properties": {
              "nativeTestimony": {
                "type": "object",
                "description": "The raw supplier payload. Its shape is selected by presence, never by provider identity."
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "providerBinding": {
                "type": "object",
                "required": [
                  "bindingId",
                  "providerId"
                ],
                "additionalProperties": false,
                "properties": {
                  "bindingId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "providerId": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "equity-market-price-evidence.v1": {
      "schemaRef": "capabilities/resolve-equity-market-price-evidence/contracts/equity-market-price-evidence.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/equity-market-price-evidence.v1.schema.json",
      "schemaDigest": "2c2b91306f9a0d32f9eab51ab7df4d2016462761409f16b89056063d401a7617",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/equity-market-price-evidence.v1.schema.json",
        "title": "Equity market price evidence",
        "description": "One canonical outcome for provider-neutral equity market price evidence: the resolved evidence, an explicit native-testimony rejection, or an explicit provider-unavailable hold. An observed price is attributable provider testimony, not an assertion of intrinsic value or cross-provider equivalence.",
        "type": "object",
        "required": [
          "contractId",
          "disposition",
          "providerTestimony"
        ],
        "additionalProperties": false,
        "properties": {
          "contractId": {
            "const": "equity-market-price-evidence.v1"
          },
          "disposition": {
            "enum": [
              "EQUITY_MARKET_PRICE_EVIDENCE_RESOLVED",
              "NATIVE_MARKET_PRICE_TESTIMONY_REJECTED",
              "EQUITY_MARKET_PRICE_PROVIDER_UNAVAILABLE"
            ]
          },
          "payload": {
            "type": "object",
            "required": [
              "symbol",
              "region",
              "currency",
              "observedPrice",
              "observedMarketTime",
              "marketState",
              "exchange",
              "sourceAttribution"
            ],
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "region": {
                "type": "string",
                "minLength": 1
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "observedPrice": {
                "type": "number"
              },
              "observedMarketTime": {
                "type": "integer",
                "minimum": 0
              },
              "marketState": {
                "type": "string",
                "minLength": 1
              },
              "exchange": {
                "type": "string",
                "minLength": 1
              },
              "sourceAttribution": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "reasonCode": {
            "enum": [
              "REQUIRED_NATIVE_FIELDS_ABSENT",
              "PROVIDER_EXCHANGE_NOT_COMPLETED"
            ]
          },
          "absentFieldCount": {
            "type": "integer",
            "minimum": 0
          },
          "providerTestimony": {
            "type": "object",
            "required": [
              "bindingId",
              "providerId"
            ],
            "additionalProperties": false,
            "properties": {
              "bindingId": {
                "type": "string",
                "minLength": 1
              },
              "providerId": {
                "type": "string",
                "minLength": 1
              },
              "nativeShape": {
                "enum": [
                  "quoteSummary.result.0.price",
                  "quoteResponse.result.0"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "EQUITY_MARKET_PRICE_EVIDENCE_RESOLVED"
                }
              }
            },
            "then": {
              "required": [
                "payload"
              ],
              "properties": {
                "reasonCode": false,
                "absentFieldCount": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "NATIVE_MARKET_PRICE_TESTIMONY_REJECTED"
                }
              }
            },
            "then": {
              "required": [
                "reasonCode",
                "absentFieldCount"
              ],
              "properties": {
                "payload": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "EQUITY_MARKET_PRICE_PROVIDER_UNAVAILABLE"
                }
              }
            },
            "then": {
              "required": [
                "reasonCode"
              ],
              "properties": {
                "payload": false,
                "absentFieldCount": false
              }
            }
          }
        ]
      }
    },
    "equity-market-price-provider-unavailable.v1": {
      "schemaRef": "capabilities/resolve-equity-market-price-evidence/contracts/equity-market-price-provider-unavailable.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/equity-market-price-provider-unavailable.v1.schema.json",
      "schemaDigest": "a6a07c6669fd7207f01e85fcaaab6618d27bf2acb88997021cea4fac9252a9eb",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/equity-market-price-provider-unavailable.v1.schema.json",
        "title": "Equity market price provider unavailable",
        "description": "Resolution is held with attributable provider attempt evidence and no price evidence is invented.",
        "type": "object",
        "required": [
          "contractId",
          "disposition"
        ],
        "properties": {
          "contractId": {
            "const": "equity-market-price-provider-unavailable.v1"
          },
          "disposition": {
            "const": "EQUITY_MARKET_PRICE_PROVIDER_UNAVAILABLE"
          },
          "providerAttemptEvidence": {
            "type": "object"
          }
        }
      }
    },
    "live-equity-price-request.v1": {
      "schemaRef": "capabilities/resolve-equity-market-price-evidence/contracts/live-equity-price-request.v1.schema.json",
      "schemaId": "https://schemas.sidefx.local/contracts/live-equity-price-request.v1.schema.json",
      "schemaDigest": "022023acbc9d13f080db86a996c8f938a5fa6c419a1c8466abc0775d82869507",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.sidefx.local/contracts/live-equity-price-request.v1.schema.json",
        "title": "Live equity price request",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "payload"
        ],
        "properties": {
          "contractId": {
            "const": "live-equity-price-request.v1"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "region"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "pattern": "^[A-Z0-9.^=-]{1,24}$"
              },
              "region": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "enum": [
                  "US"
                ]
              }
            }
          }
        }
      }
    },
    "native-equity-market-price-testimony-rejection.v1": {
      "schemaRef": "capabilities/resolve-equity-market-price-evidence/contracts/native-equity-market-price-testimony-rejection.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/native-equity-market-price-testimony-rejection.v1.schema.json",
      "schemaDigest": "43bc2474611a8cfc34a7c07be82d11455b59ff8814d0b057f842a8fa478c3fbd",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/native-equity-market-price-testimony-rejection.v1.schema.json",
        "title": "Native equity market price testimony rejection",
        "description": "The native testimony is rejected without widening the mapping or emitting canonical price evidence.",
        "type": "object",
        "required": [
          "contractId",
          "disposition",
          "reasonCode"
        ],
        "properties": {
          "contractId": {
            "const": "native-equity-market-price-testimony-rejection.v1"
          },
          "disposition": {
            "const": "NATIVE_MARKET_PRICE_TESTIMONY_REJECTED"
          },
          "reasonCode": {
            "const": "REQUIRED_NATIVE_FIELDS_ABSENT"
          },
          "absentFieldCount": {
            "type": "integer",
            "minimum": 0
          },
          "providerTestimony": {
            "type": "object"
          }
        }
      }
    },
    "native-equity-market-price-testimony.v1": {
      "schemaRef": "capabilities/resolve-equity-market-price-evidence/contracts/native-equity-market-price-testimony.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/native-equity-market-price-testimony.v1.schema.json",
      "schemaDigest": "1705422752bbd4f352d9c085608268553395e1e42abbd80b1894e9baa8847379",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/native-equity-market-price-testimony.v1.schema.json",
        "title": "Native equity market price testimony",
        "description": "The raw supplier payload admitted at the native testimony boundary. Its shape is selected by presence, never by provider identity; the canonical mapping reads either declared native shape.",
        "type": "object"
      }
    }
  }
}

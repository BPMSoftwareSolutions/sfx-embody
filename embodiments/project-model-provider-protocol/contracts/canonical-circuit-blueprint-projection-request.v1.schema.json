{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "contractId",
        "payload"
      ],
      "properties": {
        "contractId": {
          "const": "canonical-circuit-blueprint-projection-request.v1"
        },
        "payload": {
          "type": "object",
          "required": [
            "blueprintAuthorityRef",
            "blueprintCarrierBytesBase64"
          ],
          "properties": {
            "blueprintAuthorityRef": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "Exact authority digest of the blueprint being projected."
            },
            "blueprintCarrierBytesBase64": {
              "type": "string",
              "minLength": 4,
              "contentEncoding": "base64",
              "description": "The exact canonical-circuit-blueprint.v1 carrier bytes. Projection reads only these bytes, so it can never describe a blueprint it was not given."
            },
            "projectionProfileRefs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "contractId",
        "payload"
      ],
      "description": "The projection bundle admitted at each downstream scenario boundary, where the carrier is the previously admitted outcome.",
      "properties": {
        "contractId": {
          "const": "canonical-circuit-blueprint-projection-bundle.v2"
        },
        "payload": {
          "type": "object",
          "required": [
            "projectionBundle"
          ],
          "properties": {
            "projectionBundle": {
              "type": "object",
              "required": [
                "receipt",
                "carrier",
                "sources"
              ]
            }
          }
        }
      }
    }
  ]
}

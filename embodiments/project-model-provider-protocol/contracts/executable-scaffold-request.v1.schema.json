{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "contractId",
        "payload"
      ],
      "properties": {
        "contractId": {
          "const": "executable-scaffold-request.v1"
        },
        "payload": {
          "type": "object",
          "required": [
            "capabilityId",
            "featureDigest",
            "declaredScenarios",
            "terminalNodes",
            "declaredCapabilitySlots",
            "declaredProviderSlots",
            "estateInventory",
            "mechanicCatalog",
            "declaredTopology"
          ],
          "properties": {
            "capabilityId": {
              "type": "string",
              "minLength": 1
            },
            "featureDigest": {
              "$ref": "#/$defs/digest"
            },
            "declaredScenarios": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "object",
                "required": [
                  "scenarioId",
                  "inputId",
                  "inputContractId",
                  "eventId",
                  "eventAuthorityId",
                  "outcomeId",
                  "outcomeContractId"
                ],
                "properties": {
                  "scenarioId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "inputId": {
                    "type": "string"
                  },
                  "inputContractId": {
                    "type": "string"
                  },
                  "eventId": {
                    "type": "string"
                  },
                  "eventAuthorityId": {
                    "type": "string"
                  },
                  "outcomeId": {
                    "type": "string"
                  },
                  "outcomeContractId": {
                    "type": "string"
                  }
                }
              },
              "description": "The disassembled scenario set. Optional when a canonical blueprint conditions the request; supplied here it is cross-checked against that blueprint rather than believed."
            },
            "terminalNodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "nodeId",
                  "terminalDisposition"
                ],
                "properties": {
                  "nodeId": {
                    "type": "string"
                  },
                  "terminalDisposition": {
                    "type": "string"
                  }
                }
              }
            },
            "declaredCapabilitySlots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "slotId"
                ],
                "properties": {
                  "slotId": {
                    "type": "string"
                  }
                }
              }
            },
            "declaredProviderSlots": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "slotId"
                ],
                "properties": {
                  "slotId": {
                    "type": "string"
                  }
                }
              }
            },
            "estateInventory": {
              "type": "object",
              "required": [
                "supplied",
                "capabilities"
              ]
            },
            "mechanicCatalog": {
              "type": "object",
              "required": [
                "supplied",
                "mechanics"
              ]
            },
            "declaredTopology": {
              "type": "object",
              "required": [
                "supplied"
              ],
              "description": "Designed topology. Routes, variants, convergence and precedence are authored meaning and are never derived by the scaffold.",
              "properties": {
                "supplied": {
                  "type": "boolean"
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "edgeId",
                      "from",
                      "to",
                      "topology",
                      "semanticProgress",
                      "semanticPrecedence"
                    ],
                    "properties": {
                      "edgeId": {
                        "type": "string"
                      },
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "topology": {
                        "type": "string"
                      },
                      "semanticProgress": {
                        "type": "string"
                      },
                      "semanticPrecedence": {
                        "type": "string"
                      },
                      "selectingVariant": {
                        "type": "string"
                      }
                    }
                  }
                },
                "provenance": {
                  "type": "object",
                  "required": [
                    "kind"
                  ],
                  "description": "Where this topology came from. Archetype instantiation binds identities and configuration only; geometry is immutable.",
                  "properties": {
                    "kind": {
                      "enum": [
                        "ARCHETYPE_INSTANTIATION",
                        "ARCHETYPE_COMPOSITION",
                        "DESIGN_RESOLVER_CANDIDATE"
                      ]
                    },
                    "archetypeId": {
                      "type": "string"
                    },
                    "archetypeDigest": {
                      "type": "string"
                    },
                    "archetypes": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "archetypeTopology": {
                      "type": "object",
                      "properties": {
                        "nodes": {
                          "type": "array"
                        },
                        "edges": {
                          "type": "array"
                        }
                      }
                    }
                  }
                }
              }
            },
            "canonicalBlueprint": {
              "type": "object",
              "description": "The canonical circuit blueprint conditioning this scaffold. When supplied, scenarios, terminals, routes, ordinals, altitudes, observability, binding authority and projection authorities are read from it, and no competing circuit is emitted.",
              "required": [
                "nodes",
                "edges"
              ],
              "properties": {
                "carrierVersion": {
                  "type": "string"
                },
                "blueprintAuthority": {
                  "type": "object",
                  "properties": {
                    "blueprintId": {
                      "type": "string"
                    },
                    "authorityDigest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                },
                "sourceAuthority": {
                  "type": "object",
                  "properties": {
                    "disposition": {
                      "enum": [
                        "ADMITTED",
                        "CANDIDATE"
                      ]
                    }
                  }
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "nodeId",
                      "kind"
                    ],
                    "properties": {
                      "nodeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The blueprint node vocabulary is owned by the canonical circuit blueprint contract. Constraining it here would let a scaffold reject an admitted design it simply had not seen before."
                      },
                      "altitude": {
                        "type": "string"
                      },
                      "projectionOrdinal": {
                        "type": "integer"
                      },
                      "observability": {},
                      "terminalDisposition": {
                        "type": "string"
                      },
                      "cell": {
                        "type": "object"
                      }
                    }
                  }
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "edgeId",
                      "from",
                      "to"
                    ],
                    "properties": {
                      "edgeId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "topology": {
                        "type": "string"
                      },
                      "semanticProgress": {
                        "type": "string"
                      },
                      "semanticPrecedence": {
                        "type": "string"
                      },
                      "selectingVariant": {
                        "type": "string"
                      },
                      "bindingAuthority": {},
                      "observability": {},
                      "projectionOrdinal": {
                        "type": "integer"
                      }
                    }
                  }
                },
                "projectionAuthorities": {},
                "serviceLevel": {},
                "structuralMapping": {}
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "description": "The scaffold admitted at each downstream scenario boundary, where the carrier is the previously admitted outcome.",
      "required": [
        "contractId",
        "executionShell",
        "disposition"
      ],
      "properties": {
        "contractId": {
          "enum": [
            "executable-capability-scaffold.v1",
            "scaffold-derivation-carrier.v1"
          ]
        },
        "executionShell": {
          "type": "object"
        },
        "disposition": {
          "enum": [
            "SCAFFOLD_READY",
            "SCAFFOLD_INCOMPLETE",
            "HELD"
          ]
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

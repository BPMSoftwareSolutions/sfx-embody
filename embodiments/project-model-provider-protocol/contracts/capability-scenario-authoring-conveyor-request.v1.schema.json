{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "properties": {
    "capabilityId": {
      "type": "string"
    },
    "featureBytes": {
      "type": "string"
    },
    "executionStatus": {
      "type": "string"
    },
    "targetScenarioId": {
      "type": "string"
    },
    "attemptBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "capabilityId",
    "attemptBudget"
  ]
}

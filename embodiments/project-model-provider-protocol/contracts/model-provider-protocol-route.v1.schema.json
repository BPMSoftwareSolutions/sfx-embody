{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/model-provider-protocol-route.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "route", "request"],
  "properties": {
    "contractId": { "const": "model-provider-protocol-route.v1" },
    "route": {
      "type": "string",
      "enum": [
        "project-gemini-text",
        "project-gemini-structured",
        "project-gemini-endpoint",
        "project-openai-text",
        "project-openai-structured",
        "normalize-observation",
        "normalize-gemini-blocking",
        "normalize-provider-http-failure",
        "normalize-provider-transport",
        "normalize-model-response-format",
        "reject-unsupported-provider",
        "reject-unsupported-interaction-mode",
        "reject-unsupported-schema-vocabulary",
        "reject-unsupported-adapter-authority",
        "prove-determinism",
        "prove-effects"
      ]
    },
    "request": {
      "$ref": "https://schemas.agentic-harness.local/contracts/input.schema.json"
    }
  }
}

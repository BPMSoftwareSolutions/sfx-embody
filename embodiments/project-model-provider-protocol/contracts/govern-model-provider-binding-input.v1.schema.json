{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "required": ["contractId", "payload"],
      "properties": {
        "contractId": {
          "const": "govern-model-provider-binding-input.v1"
        },
        "payload": {
          "type": "object",
          "required": ["requestKind", "providerId", "modelId", "findings"],
          "properties": {
            "requestKind": { "type": "string" },
            "providerId": { "type": "string" },
            "modelId": { "type": "string" },
            "interactionMode": { "type": "string" },
            "endpointUrl": { "type": "string" },
            "credentialReference": { "type": "string" },
            "adapterIdentity": { "type": "string" },
            "adapterCapabilityId": { "type": "string" },
            "requestProjectionCapabilityId": { "type": "string" },
            "testimonyNormalizationCapabilityId": { "type": "string" },
            "hostCoverage": {
              "type": "array",
              "items": { "type": "string" }
            },
            "authorityDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "conformanceEvidence": {
              "type": "object",
              "required": [
                "receiptKind",
                "capabilityRootRef",
                "projectionManifestRef",
                "projectionManifestSha256",
                "projectedTargets",
                "fixtureConformance",
                "directSemanticOutcomeSha256",
                "crossTargetDisposition"
              ]
            },
            "findings": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["contractId", "disposition", "bindingStatus", "findings"],
      "properties": {
        "contractId": {
          "const": "governed-model-provider-binding-evidence.v1"
        },
        "disposition": {
          "enum": ["admitted", "held", "rejected"]
        },
        "bindingStatus": { "type": "string" },
        "providerId": { "type": "string" },
        "modelId": { "type": "string" },
        "adapterIdentity": { "type": "string" },
        "adapterCapabilityId": { "type": "string" },
        "requestProjectionCapabilityId": { "type": "string" },
        "testimonyNormalizationCapabilityId": { "type": "string" },
        "conformanceEvidence": { "type": "object" },
        "findings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  ]
}

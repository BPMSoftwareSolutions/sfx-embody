{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "required": ["contractId", "payload"],
      "description": "One provisioning batch, its observed artifacts, and the artifact catalog that classifies them. Walking a tree and scanning bytes are effects performed elsewhere; what arrives here is observation.",
      "properties": {
        "contractId": { "const": "capability-provisioning-request.v1" },
        "payload": {
          "type": "object",
          "required": ["batchRequest", "observedArtifacts", "declaredArtifactCatalog"],
          "properties": {
            "batchRequest": {
              "type": "object",
              "required": ["batchId", "sourceNodeId", "declaredZoneId", "selections"],
              "properties": {
                "batchId": { "type": "string", "minLength": 1 },
                "sourceNodeId": { "type": "string", "minLength": 1 },
                "declaredZoneId": { "type": "string", "minLength": 1 },
                "selections": {
                  "type": "array",
                  "description": "What the batch declared it was provisioning. An empty selection set is a failure to declare, never a batch that selected nothing.",
                  "items": { "type": "object" }
                },
                "policyAllowances": {
                  "type": "array",
                  "description": "Explicit exceptions. Each must name both the artifact and the rule it excuses; an allowance naming neither is unbounded and is itself a finding.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "relativePath": { "type": "string", "minLength": 1 },
                      "ruleId": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            },
            "observedArtifacts": {
              "type": "object",
              "required": ["supplied", "artifacts"],
              "properties": {
                "supplied": { "type": "boolean" },
                "artifacts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["relativePath", "digestHex", "digestShard", "byteLength", "extension", "observedAt", "policyScreen"],
                    "properties": {
                      "relativePath": { "type": "string", "minLength": 1 },
                      "digestHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "digestShard": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{2}$",
                        "description": "The content-address shard of the digest. Reported by the observer because the admitted transformation vocabulary cannot take a substring."
                      },
                      "declaredDigestHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                      "byteLength": { "type": "integer", "minimum": 0 },
                      "extension": { "type": "string", "minLength": 1 },
                      "observedAt": { "type": "string", "minLength": 1 },
                      "refinementState": { "type": "string" },
                      "candidateCapabilityId": { "type": "string" },
                      "artifactRole": { "type": "string" },
                      "policyScreen": {
                        "type": "object",
                        "required": ["applied"],
                        "description": "The secret policy screen already applied to the bytes. Supplied as testimony because pattern matching is not an admitted transformation operation.",
                        "properties": {
                          "applied": { "type": "boolean" },
                          "findings": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": ["ruleId"],
                              "properties": {
                                "ruleId": { "type": "string", "minLength": 1 },
                                "line": { "type": ["integer", "null"] }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "declaredArtifactCatalog": {
              "type": "object",
              "required": ["supplied", "entries"],
              "description": "The declared binding of extension to artifact type, language and media type. Classification is read from here, never inferred.",
              "properties": {
                "supplied": { "type": "boolean" },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["extension", "artifactType", "language", "mediaType"],
                    "properties": {
                      "extension": { "type": "string", "minLength": 1 },
                      "artifactType": { "type": "string", "minLength": 1 },
                      "language": { "type": "string", "minLength": 1 },
                      "mediaType": { "type": "string", "minLength": 1 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["contractId", "disposition"],
      "description": "The provisioning decision admitted at each downstream scenario boundary, where the carrier is the previously admitted outcome.",
      "properties": {
        "contractId": { "enum": ["capability-provisioning-decision.v1", "provisioning-carrier.v1"] },
        "disposition": { "enum": ["PROVISIONED", "HELD"] }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "required": [
    "contractId",
    "payload"
  ],
  "properties": {
    "contractId": {
      "enum": [
        "realization-api-delivery-request.v1",
        "realization-api-delivery-result.v1"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "operation"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "list-capabilities",
            "plan-realization",
            "project-capability",
            "observe-projection",
            "dispose-realizations",
            "unhandled"
          ]
        }
      }
    }
  }
}

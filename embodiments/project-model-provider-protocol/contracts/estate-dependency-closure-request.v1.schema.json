{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "required": ["contractId", "payload"],
      "description": "One presented estate inventory. Extraction of capsules from durable storage is an effect boundary this capability does not own; it resolves the closure of whatever inventory it is given.",
      "properties": {
        "contractId": { "const": "estate-dependency-closure-request.v1" },
        "payload": {
          "type": "object",
          "required": ["estateInventory"],
          "properties": {
            "estateInventory": {
              "type": "object",
              "required": ["supplied", "capsules"],
              "properties": {
                "supplied": { "type": "boolean" },
                "capsules": {
                  "type": "array",
                  "description": "Every admitted capsule the estate presents. An empty array is a failure to present an estate, never an estate that has achieved closure.",
                  "items": {
                    "type": "object",
                    "required": ["capabilityId"],
                    "properties": {
                      "capabilityId": { "type": "string", "minLength": 1 },
                      "applicationBinding": {
                        "type": "object",
                        "description": "The target's runtime application binding, recanonicalized and rehashed on every resolution rather than trusted from its recorded digest."
                      },
                      "capabilityAuthorityDigest": { "$ref": "#/$defs/digest" },
                      "declaredDependencies": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["bindingRef", "pinnedBindingDigest", "pinnedAuthorityDigest"],
                          "properties": {
                            "bindingRef": {
                              "type": "string",
                              "minLength": 1,
                              "description": "The admitted capability this dependency resolves to. Name agreement alone is never accepted as resolution."
                            },
                            "pinnedBindingDigest": { "$ref": "#/$defs/digest" },
                            "pinnedAuthorityDigest": { "$ref": "#/$defs/digest" }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["contractId", "disposition"],
      "description": "The closure admitted at each downstream scenario boundary, where the carrier is the previously admitted outcome.",
      "properties": {
        "contractId": {
          "enum": ["estate-dependency-closure.v1", "estate-closure-carrier.v1"]
        },
        "disposition": { "enum": ["RESOLVED", "BROKEN"] }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}

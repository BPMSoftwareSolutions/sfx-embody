{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "contractId",
        "payload"
      ],
      "properties": {
        "contractId": {
          "const": "proof-obligation-request.v1"
        },
        "payload": {
          "type": "object",
          "required": [
            "capabilityId",
            "inputContract",
            "outcomeContract",
            "terminalDispositions",
            "observableConditions",
            "effectFailures",
            "declaresEffects",
            "suppliedFixtureCandidates"
          ],
          "properties": {
            "capabilityId": {
              "type": "string",
              "minLength": 1
            },
            "inputContract": {
              "type": "object",
              "required": [
                "contractId",
                "requiredFields",
                "constrainedFields"
              ],
              "properties": {
                "contractId": {
                  "type": "string",
                  "minLength": 1
                },
                "requiredFields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "constrainedFields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "outcomeContract": {
              "type": "object",
              "required": [
                "contractId"
              ],
              "properties": {
                "contractId": {
                  "type": "string",
                  "minLength": 1
                },
                "successVariant": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "terminalDispositions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "observableConditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "effectFailures": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "declaresEffects": {
              "type": "boolean"
            },
            "suppliedFixtureCandidates": {
              "type": "array",
              "description": "Fixture candidates offered by a caller. A candidate carrying a concrete domain value has decided the answer rather than declared the obligation.",
              "items": {
                "type": "object",
                "required": [
                  "fixtureId"
                ],
                "properties": {
                  "fixtureId": {
                    "type": "string"
                  },
                  "value": {}
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "contractId",
        "disposition"
      ],
      "description": "The obligation set admitted at each downstream scenario boundary, where the carrier is the previously admitted outcome.",
      "properties": {
        "contractId": {
          "enum": [
            "capability-proof-obligation-set.v1",
            "proof-obligation-carrier.v1"
          ]
        },
        "disposition": {
          "enum": [
            "PROOF_OBLIGATIONS_CLOSED",
            "PROOF_OBLIGATIONS_INCOMPLETE",
            "HELD"
          ]
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

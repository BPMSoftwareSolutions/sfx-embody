{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/input.schema.json",
  "type": "object",
  "anyOf": [
    {
      "type": "object",
      "required": ["contractId", "payload"],
      "properties": {
        "contractId": { "const": "provider-candidate-completeness-request.v1" },
        "payload": {
          "type": "object",
          "required": ["generation", "providerInventory", "evidenceRows", "expectedCoverage", "carrier", "replay"],
          "properties": {
            "generation": {
              "type": "object",
              "required": ["generationDigest", "blueprintDigest", "policyDigest", "featureDigest"],
              "properties": {
                "generationDigest": { "$ref": "#/$defs/digest" },
                "blueprintDigest": { "$ref": "#/$defs/digest" },
                "policyDigest": { "$ref": "#/$defs/digest" },
                "featureDigest": { "$ref": "#/$defs/digest" }
              }
            },
            "providerInventory": {
              "type": "object",
              "required": [
                "providerSlotsDeclared",
                "effectBoundariesDeclared",
                "delegatingDependenciesDeclared",
                "providerSlots",
                "effectBoundariesRequiringProvider",
                "providerDelegatingDependencies"
              ],
              "properties": {
                "providerSlotsDeclared": { "type": "boolean" },
                "effectBoundariesDeclared": { "type": "boolean" },
                "delegatingDependenciesDeclared": { "type": "boolean" },
                "providerSlots": {
                  "type": "array",
                  "items": { "type": "object", "required": ["slotId"], "properties": { "slotId": { "type": "string", "minLength": 1 } } }
                },
                "effectBoundariesRequiringProvider": {
                  "type": "array",
                  "items": { "type": "object", "required": ["boundaryId"], "properties": { "boundaryId": { "type": "string", "minLength": 1 } } }
                },
                "providerDelegatingDependencies": {
                  "type": "array",
                  "items": { "type": "object", "required": ["dependencyId"], "properties": { "dependencyId": { "type": "string", "minLength": 1 } } }
                }
              }
            },
            "evidenceRows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["slotId", "generationDigest", "evidenceClass", "authorizesSelection", "selection", "obligations"],
                "properties": {
                  "slotId": { "type": "string", "minLength": 1 },
                  "generationDigest": { "$ref": "#/$defs/digest" },
                  "evidenceClass": {
                    "enum": ["SHAPE_OBSERVATION", "PUBLISHED_SEMANTICS", "SCENARIO_FIT_HYPOTHESIS", "ADMITTED_PRECEDENT"]
                  },
                  "authorizesSelection": { "type": "boolean" },
                  "selection": {
                    "type": "object",
                    "required": ["kind"],
                    "properties": {
                      "kind": { "enum": ["EXACT_OPERATION", "CLOSED_PROFILE", "NOMINATION_ONLY", "UNRESOLVED"] },
                      "operationId": { "type": "string" },
                      "profileMembers": { "type": "array", "items": { "type": "string" } }
                    }
                  },
                  "obligations": {
                    "type": "object",
                    "required": [
                      "semantics",
                      "canonicalContracts",
                      "nativeMapping",
                      "effects",
                      "authorization",
                      "conformance",
                      "targetRealization",
                      "precedent"
                    ],
                    "properties": {
                      "semantics": { "$ref": "#/$defs/obligation" },
                      "canonicalContracts": { "$ref": "#/$defs/obligation" },
                      "nativeMapping": { "$ref": "#/$defs/obligation" },
                      "effects": { "$ref": "#/$defs/obligation" },
                      "authorization": { "$ref": "#/$defs/obligation" },
                      "conformance": { "$ref": "#/$defs/obligation" },
                      "targetRealization": { "$ref": "#/$defs/obligation" },
                      "precedent": { "$ref": "#/$defs/obligation" }
                    }
                  }
                }
              }
            },
            "expectedCoverage": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "carrier": {
              "type": "object",
              "required": ["blackoutEngaged", "providerMeaningCompleteBeforeBlackout"],
              "properties": {
                "blackoutEngaged": { "type": "boolean" },
                "providerMeaningCompleteBeforeBlackout": { "type": "boolean" }
              }
            },
            "replay": {
              "type": "object",
              "required": ["firstProductDigest", "secondProductDigest"],
              "properties": {
                "firstProductDigest": { "$ref": "#/$defs/digest" },
                "secondProductDigest": { "$ref": "#/$defs/digest" }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["contractId", "applicability", "disposition", "coverage", "findings", "replay"],
      "properties": {
        "contractId": { "const": "provider-candidate-completeness-receipt.v1" },
        "capabilityId": { "const": "qualify-provider-candidate-completeness" },
        "generationDigest": { "$ref": "#/$defs/digest" },
        "blueprintDigest": { "$ref": "#/$defs/digest" },
        "policyDigest": { "$ref": "#/$defs/digest" },
        "applicability": { "enum": ["APPLICABLE", "NOT_APPLICABLE"] },
        "coverage": {
          "type": "object",
          "required": ["expected", "verified"],
          "properties": {
            "expected": { "type": "integer", "minimum": 0 },
            "verified": { "type": "integer", "minimum": 0 }
          }
        },
        "disposition": { "enum": ["CONFORMS", "NOT_APPLICABLE", "HELD"] },
        "findings": {
          "type": "array",
          "items": { "type": "object", "required": ["code"], "properties": { "code": { "type": "string" } } }
        },
        "replay": {
          "type": "object",
          "required": ["firstProductDigest", "secondProductDigest", "byteIdentical"],
          "properties": {
            "firstProductDigest": { "$ref": "#/$defs/digest" },
            "secondProductDigest": { "$ref": "#/$defs/digest" },
            "byteIdentical": { "type": "boolean" }
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "obligation": { "enum": ["CLOSED", "OPEN"] }
  }
}

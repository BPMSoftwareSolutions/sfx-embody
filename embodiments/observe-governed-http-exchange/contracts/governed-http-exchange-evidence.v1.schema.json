{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentic-harness.local/contracts/governed-http-exchange-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "disposition",
    "exchangeKind",
    "transportDisposition",
    "httpStatus",
    "allowedResponseHeaders",
    "boundedBytes",
    "requestBodyHash",
    "responseBodyHash",
    "responseBodyBytes",
    "reachedStage",
    "exchangeCount",
    "timing",
    "redactionVerified",
    "lineageId",
    "effectLineage"
  ],
  "properties": {
    "contractId": { "const": "governed-http-exchange-evidence.v1" },
    "disposition": {
      "enum": [
        "completed",
        "retained-non-success",
        "rejected-endpoint",
        "rejected-credential",
        "timed-out",
        "cancelled",
        "transport-failed",
        "oversized-response-rejected"
      ]
    },
    "exchangeKind": { "type": "string" },
    "transportDisposition": { "type": "string" },
    "httpStatus": { "type": "integer", "minimum": 0, "maximum": 599 },
    "allowedResponseHeaders": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "boundedBytes": { "type": "integer", "minimum": 0 },
    "requestBodyHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "responseBodyHash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "responseBodyBytes": {
      "type": ["string", "null"],
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "reachedStage": { "type": "string" },
    "exchangeCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt", "durationMilliseconds"],
      "properties": {
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 }
      }
    },
    "redactionVerified": { "const": true },
    "lineageId": { "type": "string" },
    "effectLineage": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

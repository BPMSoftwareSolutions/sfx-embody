{
  "authorityType": "consumer-contract-authorities.v1",
  "contracts": {
    "bind-external-credential-reference-input.v1": {
      "schemaRef": "bind-external-credential-reference-input.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/bind-external-credential-reference-input.schema.json",
      "schemaDigest": "365e8700fb38f1e966c86b5a63fd46ed36d2e0ac35510eb4dfc8f4686dc30cea",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/bind-external-credential-reference-input.schema.json",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractId",
              "payload"
            ],
            "properties": {
              "contractId": {
                "const": "bind-external-credential-reference-input.v1"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "credentialReference",
                  "invocationIdentity",
                  "requestingCapabilityId",
                  "endpointAuthorityDigest",
                  "effectScope"
                ],
                "properties": {
                  "scenarioMode": {
                    "type": "string"
                  },
                  "credentialReference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "invocationIdentity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "requestingCapabilityId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "endpointAuthorityDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "effectScope": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effectLineage": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "contractId",
              "disposition",
              "opaqueBindingId",
              "nonDisclosureVerified"
            ],
            "properties": {
              "contractId": {
                "const": "external-credential-binding-evidence.v1"
              },
              "disposition": {
                "type": "string"
              },
              "opaqueBindingId": {
                "type": "string"
              },
              "nonDisclosureVerified": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "external-credential-binding-evidence.v1": {
      "schemaRef": "external-credential-binding-evidence.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/external-credential-binding-evidence.schema.json",
      "schemaDigest": "bd5f4f53ad9320de928247798ab52730ac8af19aeaf46a6be0ba5de3e1c8f7dd",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/external-credential-binding-evidence.schema.json",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "disposition",
          "opaqueBindingId",
          "referenceName",
          "invocationIdentity",
          "requestingCapabilityId",
          "endpointAuthorityDigest",
          "credentialInjectionRuleId",
          "nonDisclosureVerified",
          "detail",
          "effectLineage"
        ],
        "properties": {
          "contractId": {
            "const": "external-credential-binding-evidence.v1"
          },
          "disposition": {
            "enum": [
              "BOUND",
              "CREDENTIAL_NOT_AVAILABLE",
              "UNAUTHORIZED_REFERENCE",
              "IDENTITY_MISMATCH",
              "STALE_BINDING_REJECTED",
              "EMBEDDED_CREDENTIAL_REJECTED"
            ]
          },
          "opaqueBindingId": {
            "type": "string"
          },
          "referenceName": {
            "type": "string"
          },
          "invocationIdentity": {
            "type": "string"
          },
          "requestingCapabilityId": {
            "type": "string"
          },
          "endpointAuthorityDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "credentialInjectionRuleId": {
            "type": "string"
          },
          "nonDisclosureVerified": {
            "const": true
          },
          "detail": {
            "type": "string"
          },
          "effectLineage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
{
  "authorityType": "consumer-contract-authorities.v1",
  "contracts": {
    "governed-http-exchange-evidence.v1": {
      "schemaRef": "governed-http-exchange-evidence.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/governed-http-exchange-evidence.schema.json",
      "schemaDigest": "fd92ed1905e241e59c675d8b4c8491624dcd83fd225f202d21def356b6d245e8",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/governed-http-exchange-evidence.schema.json",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId",
          "disposition",
          "exchangeKind",
          "transportDisposition",
          "httpStatus",
          "allowedResponseHeaders",
          "boundedBytes",
          "requestBodyHash",
          "responseBodyHash",
          "responseBodyBytes",
          "reachedStage",
          "exchangeCount",
          "timing",
          "redactionVerified",
          "lineageId",
          "effectLineage"
        ],
        "properties": {
          "contractId": {
            "const": "governed-http-exchange-evidence.v1"
          },
          "disposition": {
            "enum": [
              "completed",
              "retained-non-success",
              "rejected-endpoint",
              "rejected-credential",
              "timed-out",
              "cancelled",
              "transport-failed",
              "oversized-response-rejected"
            ]
          },
          "exchangeKind": {
            "type": "string"
          },
          "transportDisposition": {
            "type": "string"
          },
          "httpStatus": {
            "type": "integer",
            "minimum": 0,
            "maximum": 599
          },
          "allowedResponseHeaders": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "boundedBytes": {
            "type": "integer",
            "minimum": 0
          },
          "requestBodyHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "responseBodyHash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "responseBodyBytes": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          },
          "reachedStage": {
            "type": "string"
          },
          "exchangeCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "startedAt",
              "completedAt",
              "durationMilliseconds"
            ],
            "properties": {
              "startedAt": {
                "type": "string"
              },
              "completedAt": {
                "type": "string"
              },
              "durationMilliseconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "redactionVerified": {
            "const": true
          },
          "lineageId": {
            "type": "string"
          },
          "effectLineage": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "observe-governed-http-exchange-input.v1": {
      "schemaRef": "observe-governed-http-exchange-input.v1.schema.json",
      "schemaId": "https://schemas.agentic-harness.local/contracts/observe-governed-http-exchange-input.schema.json",
      "schemaDigest": "b332bb30b838fdbd03898c6fcb2542552ad35415903b77f80eec0b8d391e311a",
      "schema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.agentic-harness.local/contracts/observe-governed-http-exchange-input.schema.json",
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contractId",
              "payload"
            ],
            "properties": {
              "contractId": {
                "const": "observe-governed-http-exchange-input.v1"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "exchangeKind",
                  "invocationIdentity",
                  "endpointAuthorityDigest",
                  "requestUrl",
                  "method",
                  "safeHeaders",
                  "requestBodyText",
                  "opaqueCredentialBinding",
                  "credentialInjectionRuleId",
                  "timeoutMilliseconds",
                  "cancellationScopeReference",
                  "maxResponseBytes",
                  "redirectPolicy",
                  "allowedResponseHeaders",
                  "lineageId"
                ],
                "properties": {
                  "exchangeKind": {
                    "type": "string",
                    "minLength": 1
                  },
                  "invocationIdentity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "endpointAuthorityDigest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "requestUrl": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "const": "POST"
                  },
                  "safeHeaders": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "opaqueCredentialBinding": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "bindingId",
                      "credentialInjectionRuleId"
                    ],
                    "properties": {
                      "bindingId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "credentialInjectionRuleId": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "credentialInjectionRuleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timeoutMilliseconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "cancellationScopeReference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "maxResponseBytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "redirectPolicy": {
                    "const": "manual-no-follow"
                  },
                  "allowedResponseHeaders": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "lineageId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effectLineage": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "requestBodyText": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "contractId",
              "disposition",
              "exchangeKind",
              "exchangeCount",
              "redactionVerified"
            ],
            "properties": {
              "contractId": {
                "const": "governed-http-exchange-evidence.v1"
              },
              "disposition": {
                "type": "string"
              },
              "exchangeKind": {
                "type": "string"
              },
              "exchangeCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1
              },
              "redactionVerified": {
                "const": true
              }
            }
          }
        ]
      }
    }
  }
}